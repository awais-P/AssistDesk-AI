# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (local Postgres 15+, Neon, Supabase…)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/assistdesk?schema=public"

# 32+ random characters. Encrypts provider API keys, SMTP passwords and channel tokens,
# and signs chat-widget tokens. REQUIRED in production; changing it makes saved keys unreadable.
ASSISTDESK_ENCRYPTION_KEY=""

# Public URL of this app (used in email confirmation links, password reset links, OpenRouter headers, and widget)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Managed "Default" AI provider keys (at least one). Groq is tried first, then Gemini, then OpenRouter.
ASSISTDESK_DEFAULT_GROQ_API_KEY=""
ASSISTDESK_DEFAULT_GOOGLE_API_KEY=""
ASSISTDESK_DEFAULT_OPENROUTER_API_KEY=""

# Website crawling (SRS CON-6). Optional: without it the built-in crawler is used.
FIRECRAWL_API_KEY=""

# Image/attachment storage (SRS CON-7). Optional: without it files go to ./storage/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Platform email (verification, password reset, alerts, ticket replies). Hosts that block
# SMTP (Railway Trial/Hobby) need BREVO_API_KEY: emails then go through Brevo's HTTPS API
# from ASSISTDESK_SMTP_FROM, which must be a verified sender in Brevo. Without it, SMTP below is used.
BREVO_API_KEY=""

# Voice calls in the website widget (Module 6): Deepgram speech-to-text and text-to-speech.
# A key with "Member" permission (it creates short-lived tokens for the browser). Free $200 credit.
DEEPGRAM_API_KEY=""
# Optional: other Deepgram models.
# ASSISTDESK_VOICE_STT_MODEL="nova-3"
# ASSISTDESK_VOICE_TTS_MODEL="aura-2-thalia-en"
# Default outbound email sender for ticket replies (inboxes can override with their own SMTP).
ASSISTDESK_SMTP_HOST=""
ASSISTDESK_SMTP_PORT="587"
ASSISTDESK_SMTP_SECURE="false"
ASSISTDESK_SMTP_USER=""
ASSISTDESK_SMTP_PASSWORD=""
ASSISTDESK_SMTP_FROM=""
ASSISTDESK_EMAIL_DOMAIN="assistdesk.ai"

# Module 5: country code used to normalise national phone numbers typed in the widget
# (e.g. 0300-1234567 -> +923001234567) so they match the same customer on WhatsApp. Default 92.
ASSISTDESK_DEFAULT_COUNTRY_CODE="92"

# WhatsApp Cloud API Graph version (optional)
WHATSAPP_GRAPH_VERSION="v23.0"

# Knowledge base embeddings (Module 10). Default: openrouter:openai/text-embedding-3-small
# (uses the managed OpenRouter key). Alternatives: google:gemini-embedding-001, openai:text-embedding-3-small
ASSISTDESK_EMBEDDING_MODEL=""
OPENAI_API_KEY=""

# Pinecone vector database (SRS OE-3). Create a serverless index with dimension 1536 and
# metric cosine; each workspace gets its own namespace. Without these, vectors stay in PostgreSQL.
PINECONE_API_KEY=""
PINECONE_INDEX=""

# Scheduled jobs. A normal server runs them itself every 5 minutes (instrumentation.ts);
# set ASSISTDESK_BACKGROUND_JOBS=false to turn that off. On serverless hosting the cron
# routes below do the same work (vercel.json schedules them) and need CRON_SECRET, sent as
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it automatically).
#   /api/cron/knowledge  re-queues interrupted indexing jobs (Module 10)
#   /api/cron/sessions   closes idle conversations, ticket follow-ups and auto-close, SLA, billing
#   /api/cron/webhooks   sends due webhook retries (Module 8)
CRON_SECRET=""
# ASSISTDESK_BACKGROUND_JOBS=false

# Local demo workspace (development only, never in production).
ASSISTDESK_SEED_DEMO="false"
ASSISTDESK_DEMO_PASSWORD=""

# Module 8: allow outgoing lead webhooks to localhost/private IPs (development only; ignored
# in production). Needed to test against a local receiver such as http://127.0.0.1:4555.
ASSISTDESK_ALLOW_PRIVATE_WEBHOOKS="false"

# Module 2: allow custom HTTP tools to call localhost/private IPs (development only; ignored
# in production). Needed for the built-in sample store at http://localhost:3000.
ASSISTDESK_ALLOW_PRIVATE_TOOLS="false"
# Module 2: serve the demo sample store (/api/sample-store/*, fake orders and invoices for the
# "Order tracking" and "Invoice generation" tool templates). Always on in development; set to
# "true" to keep it on in a production demo deployment.
ASSISTDESK_SAMPLE_STORE="false"

# Module 3 billing (Stripe). Without a key, development uses a labelled TEST mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ASSISTDESK_BILLING_TEST_MODE=false
