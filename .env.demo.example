# Demo and test environment for `npm run demo`, `npm run test:ui`, `npm run test:integration`
# and the scripts in scripts/e2e. Copy this file to .env.demo (git-ignored) and fill it in:
#
#   Copy-Item .env.demo.example .env.demo
#
# Use a local or throwaway database, never production: the demo data and the tests create,
# change and delete records. AI provider keys are read from your normal .env as usual.

# The demo/test database. With docker compose (published on port 5433), for example:
#   postgresql://assistdesk:assistdesk-dev-password@localhost:5433/assistdesk_test?schema=public
# Create that database once with:
#   docker compose exec postgres createdb -U assistdesk assistdesk_test
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<database>?schema=public

# Password of the demo admin (admin@assistdesk.local) that the server creates. At least 8 characters.
ASSISTDESK_DEMO_PASSWORD=<choose a password>

# Any random string; protects the scheduled-job routes.
CRON_SECRET=<choose a secret>

# Port of the demo/test server. It builds into .next-test, so it can run next to `npm run dev`.
DEMO_PORT=3100

# Let the AI's tools and the lead webhooks call the local sample store and test receivers.
ASSISTDESK_ALLOW_PRIVATE_TOOLS=true
ASSISTDESK_ALLOW_PRIVATE_WEBHOOKS=true

# Email replies (optional). Ticket replies, including the AI's, are emailed to the customer
# through this SMTP account. With Gmail: turn on 2-Step Verification, create an App Password
# (Google Account -> Security -> App passwords) and use it below, not your normal password.
# Check it with:  npm run email:test
# Remove the # from the five lines below once they are filled in. While they are set, the UI
# tests also send their (undeliverable) example.com replies through this account.
#ASSISTDESK_SMTP_HOST=smtp.gmail.com
#ASSISTDESK_SMTP_PORT=587
#ASSISTDESK_SMTP_USER=you@gmail.com
#ASSISTDESK_SMTP_PASSWORD=<16-character app password>
#ASSISTDESK_SMTP_FROM=you@gmail.com

# Live email demo (optional): read real Gmail mailboxes connected under Integrations -> Email
# (Provider: Gmail) and turn new emails into tickets. Off unless set to true.
#ASSISTDESK_EMAIL_POLLING=true
