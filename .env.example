# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (local Postgres 15+, Neon, Supabase…)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/assistdesk?schema=public"

# 32+ random characters. Encrypts provider API keys, SMTP passwords and channel tokens,
# and signs chat-widget tokens. REQUIRED in production; changing it makes saved keys unreadable.
ASSISTDESK_ENCRYPTION_KEY=""

# Public URL of this app (used in OpenRouter headers and links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Managed "Default" AI provider keys (at least one). Groq is tried first, then Gemini, then OpenRouter.
ASSISTDESK_DEFAULT_GROQ_API_KEY=""
ASSISTDESK_DEFAULT_GOOGLE_API_KEY=""
ASSISTDESK_DEFAULT_OPENROUTER_API_KEY=""

# Website crawling (SRS CON-6). Optional: without it the built-in crawler is used.
FIRECRAWL_API_KEY=""

# Image/attachment storage (SRS CON-7). Optional: without it files go to ./storage/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Default outbound email sender for ticket replies (inboxes can override with their own SMTP).
ASSISTDESK_SMTP_HOST=""
ASSISTDESK_SMTP_PORT="587"
ASSISTDESK_SMTP_SECURE="false"
ASSISTDESK_SMTP_USER=""
ASSISTDESK_SMTP_PASSWORD=""
ASSISTDESK_SMTP_FROM=""
ASSISTDESK_EMAIL_DOMAIN="assistdesk.ai"

# Module 5: country code used to normalise national phone numbers typed in the widget
# (e.g. 0300-1234567 -> +923001234567) so they match the same customer on WhatsApp. Default 92.
ASSISTDESK_DEFAULT_COUNTRY_CODE="92"

# WhatsApp Cloud API Graph version (optional)
WHATSAPP_GRAPH_VERSION="v23.0"

# Knowledge base embeddings (Module 10). Default: openrouter:openai/text-embedding-3-small
# (uses the managed OpenRouter key). Alternatives: google:gemini-embedding-001, openai:text-embedding-3-small
ASSISTDESK_EMBEDDING_MODEL=""
OPENAI_API_KEY=""

# Pinecone vector database (SRS OE-3). Create a serverless index with dimension 1536 and
# metric cosine; each workspace gets its own namespace. Without these, vectors stay in PostgreSQL.
PINECONE_API_KEY=""
PINECONE_INDEX=""

# Protects the scheduled jobs. Send "Authorization: Bearer <CRON_SECRET>".
#   /api/cron/knowledge  re-queues interrupted indexing jobs (Module 10)
#   /api/cron/sessions   closes idle/expired conversations and cleans rate-limit counters (Module 5, every ~5 min)
CRON_SECRET=""

# Local demo workspace (development only, never in production).
ASSISTDESK_SEED_DEMO="false"
ASSISTDESK_DEMO_PASSWORD=""
