generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum TicketSource {
  WEB
  EMAIL
  WHATSAPP
  SLACK
  VOICE
  MANUAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KnowledgeSourceType {
  FILE
  URL
  TEXT
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  DELETED
}

enum ChannelType {
  WEB_WIDGET
  WHATSAPP
  SLACK
  VOICE
  EMAIL
}

enum AutomationTrigger {
  INCOMING
  SCHEDULED
}

enum IntegrationType {
  EMAIL
  WHATSAPP
  SLACK
  VOICE
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum ChatSessionStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum MessageSender {
  USER
  AI
  AGENT
  SYSTEM
}

model Workspace {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  supportEmail     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  inboxes          Inbox[]
  tickets          Ticket[]
  agents           AIAgent[]
  chatbots         Chatbot[]
  tags             Tag[]
  cannedResponses  CannedResponse[]
  apiKeys          ApiKey[]
  settings         WorkspaceSetting?
  knowledgeSources KnowledgeSource[]
  chatSessions     ChatSession[]
  agentAutomations AgentAutomation[]
  ticketMessages   TicketMessage[]
  automationLogs   AutomationLog[]
  integrations     Integration[]
}

model User {
  id              String    @id @default(cuid())
  workspaceId     String
  fullName        String
  username        String    @unique
  email           String    @unique
  passwordHash    String?
  role            UserRole  @default(ADMIN)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[]  @relation("AssignedTickets")
  createdTickets  Ticket[]  @relation("CreatedTickets")
  sessions        Session[]

  @@index([workspaceId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Inbox {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  emailPrefix      String    @unique
  ticketPrefix     String
  autoReplyEnabled Boolean   @default(false)
  senderEmail      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  agents           AIAgent[]
  integrations     Integration[]

  @@index([workspaceId])
}

model AIAgent {
  id                  String              @id @default(cuid())
  workspaceId         String
  inboxId             String?
  name                String
  provider            String              @default("Groq")
  model               String              @default("llama-3.3-70b-versatile")
  apiKey              String?
  systemPrompt        String?
  temperature         Float               @default(0.7)
  confidenceThreshold Float               @default(0.5)
  status              AgentStatus         @default(DRAFT)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox               Inbox?              @relation(fields: [inboxId], references: [id], onDelete: SetNull)
  chatbots            Chatbot[]
  knowledgeSources    KnowledgeSource[]
  automations         AgentAutomation[]
  logs                AutomationLog[]
  integrations        Integration[]

  @@index([workspaceId])
  @@index([inboxId])
}

model AgentAutomation {
  id          String            @id @default(cuid())
  workspaceId String
  agentId     String
  key         String
  title       String
  description String
  triggerType AutomationTrigger
  summary     String?
  isEnabled   Boolean           @default(false)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       AIAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([workspaceId])
  @@index([agentId])
}

model Chatbot {
  id                String      @id @default(cuid())
  workspaceId       String
  agentId           String
  name              String
  widgetId          String      @unique
  welcomeMessage    String?
  allowedDomains    String[]
  primaryColor      String      @default("#111111")
  isActive          Boolean     @default(true)
  maxAiMessages     Int         @default(20)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent             AIAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chatSessions      ChatSession[]

  @@index([workspaceId])
  @@index([agentId])
}

model KnowledgeSource {
  id           String              @id @default(cuid())
  workspaceId  String
  agentId      String?
  title        String
  type         KnowledgeSourceType
  status       SyncStatus          @default(PENDING)
  sourceUrl    String?
  fileName     String?
  mimeType     String?
  rawText      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lastSyncedAt DateTime?
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent        AIAgent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([agentId])
}

model Ticket {
  id            String         @id @default(cuid())
  workspaceId   String
  inboxId       String?
  assigneeId    String?
  createdById   String?
  ticketNumber  Int
  subject       String
  previewText   String?
  requesterName String?
  requesterEmail String?
  source        TicketSource   @default(WEB)
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox         Inbox?         @relation(fields: [inboxId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: SetNull)
  ticketTags    TicketTag[]
  messages      TicketMessage[]
  logs          AutomationLog[]

  @@unique([workspaceId, ticketNumber])
  @@index([workspaceId])
  @@index([inboxId])
  @@index([assigneeId])
}

model TicketMessage {
  id          String        @id @default(cuid())
  workspaceId String
  ticketId    String
  sender      MessageSender
  content     String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([ticketId])
}

model Tag {
  id         String      @id @default(cuid())
  workspaceId String
  name       String
  color      String      @default("#3b82f6")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketTags TicketTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TicketTag {
  ticketId   String
  tagId      String
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
}

model CannedResponse {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyPreview  String
  provider    String?
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceSetting {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  theme            String    @default("dark")
  timezone         String    @default("Asia/Karachi")
  supportSignature String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id             String            @id @default(cuid())
  workspaceId    String
  chatbotId      String?
  customerName   String?
  customerEmail  String?
  channel        ChannelType       @default(WEB_WIDGET)
  status         ChatSessionStatus @default(ACTIVE)
  startedAt      DateTime          @default(now())
  endedAt        DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot        Chatbot?          @relation(fields: [chatbotId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]

  @@index([workspaceId])
  @@index([chatbotId])
}

model ChatMessage {
  id         String        @id @default(cuid())
  sessionId  String
  sender     MessageSender
  content    String
  createdAt  DateTime      @default(now())
  session    ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AutomationLog {
  id          String    @id @default(cuid())
  workspaceId String
  ticketId    String?
  agentId     String?
  action      String
  status      String
  model       String?
  tokens      Int       @default(0)
  durationMs  Int       @default(0)
  summary     String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  agent       AIAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([ticketId])
  @@index([agentId])
  @@index([createdAt])
}

model Integration {
  id                String            @id @default(cuid())
  workspaceId       String
  inboxId           String?
  agentId           String?
  type              IntegrationType
  name              String
  provider          String
  status            IntegrationStatus @default(DISCONNECTED)
  supportAddress    String?
  forwardingAddress String?
  webhookSecret     String?
  config            Json?
  isActive          Boolean           @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox             Inbox?            @relation(fields: [inboxId], references: [id], onDelete: SetNull)
  agent             AIAgent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([inboxId])
  @@index([agentId])
  @@index([type])
}
